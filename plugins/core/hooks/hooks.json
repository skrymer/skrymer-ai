{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/session-context.mjs\"",
            "timeout": 10,
            "statusMessage": "Loading the project’s tracker and domain context"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/skill-injector.mjs\"",
            "timeout": 10,
            "statusMessage": "Finding the skills this prompt needs"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Write|Edit)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/skill-gate.mjs\"",
            "timeout": 5,
            "statusMessage": "Checking the skills this file needs"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/tdd-gate.mjs\"",
            "timeout": 120,
            "statusMessage": "Probity: checking TDD"
          }
        ]
      },
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/test-output-guard.mjs\"",
            "timeout": 5,
            "statusMessage": "Checking the test output stays whole"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/gated-write-guard.mjs\"",
            "timeout": 5,
            "statusMessage": "Checking the command writes no TDD-gated file"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Write|Edit)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/format.mjs\"",
            "timeout": 60,
            "statusMessage": "Formatting the file with its stack’s formatter"
          }
        ]
      }
    ]
  }
}
