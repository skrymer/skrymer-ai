{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Write|Edit)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/skill-gate.mjs\"",
            "timeout": 5,
            "statusMessage": "Checking the skills this file needs"
          }
        ]
      }
    ]
  }
}
