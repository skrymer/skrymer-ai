# The AppArmor profile the eval container runs under. Ubuntu restricts user namespaces that
# a process without capabilities creates, inside containers too. Claude Code's sandbox runs
# bwrap with --cap-drop ALL and no_new_privs, and its seccomp helper then creates a nested
# user namespace, which the restriction denies its capabilities. Like Ubuntu's own bwrap
# profile, this allows everything plus `userns`, in enforce mode: an unconfined-mode profile
# counts as unconfined and stays restricted.
# Load it once per boot: sudo apparmor_parser -r scripts/evals/apparmor-profile

abi <abi/5.0>,

include <tunables/global>

profile skrymer-ai-evals flags=(attach_disconnected,mediate_deleted) {
  allow capability,
  allow file rwlkm /{**,},
  allow /** ix,
  allow network,
  allow unix,
  allow ptrace,
  allow signal,
  allow mqueue,
  allow io_uring,
  allow userns,
  allow mount,
  allow umount,
  allow pivot_root,
  allow dbus,
}
